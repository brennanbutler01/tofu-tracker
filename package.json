{
    "private": true,
    "scripts": {
        "dev": "yarn styles:build && next dev --webpack",
        "lint": "eslint pages components server utils",
        "build": "yarn styles:build && next build --webpack",
        "start": "next start",
        "test": "jest --runInBand",
        "format": "prettier . --w",
        "postinstall": "prisma generate",
        "styles:build": "lessc --js styles/variables.less styles/antd.generated.css",
        "typecheck": "tsc --noEmit",
        "local:setup": "python3 scripts/setup-local.py",
        "verify:local": "node scripts/verify-local-api.mjs",
        "verify:browser": "node scripts/verify-local-browser.mjs",
        "build:portfolio": "next build portfolio-site --webpack",
        "test:portfolio": "playwright test --config=playwright.portfolio.config.ts",
        "deploy:portfolio": "yarn build:portfolio && yarn test:portfolio && python3 scripts/deploy_portfolio.py",
        "verify:learning": "node scripts/verify-learning-sessions.mjs",
        "verify:learning-browser": "node scripts/verify-learning-browser.mjs",
        "verify:grading": "node scripts/verify-grading.mjs",
        "verify:metrics-feedback": "node scripts/verify-metrics-feedback.mjs",
        "verify:authoring": "node scripts/verify-authoring.mjs",
        "verify:curriculum": "node scripts/verify-curriculum.mjs",
        "verify:question-feedback": "node scripts/verify-question-feedback.mjs",
        "verify:feedback-browser": "node scripts/verify-feedback-browser.mjs",
        "verify:visitor-workspace": "jest --config jest.visitor.config.js --runInBand",
        "verify:visitor-api": "node scripts/verify-visitor-api.mjs",
        "verify:visitor-browser": "node scripts/verify-visitor-browser.mjs",
        "verify:visitor-lifecycle": "node scripts/verify-visitor-lifecycle.mjs",
        "deploy:visitor": "python3 scripts/deploy_visitor.py"
    },
    "dependencies": {
        "@ant-design/icons": "4.8.3",
        "@next-auth/prisma-adapter": "^1.0.3",
        "@prisma/client": "7.10.0",
        "antd": "4.24.16",
        "axios": "1.20.0",
        "cuid": "^2.1.8",
        "dayjs": "^1.11.1",
        "fast-deep-equal": "^3.1.3",
        "next": "16.3.4",
        "next-auth": "4.24.15",
        "nextjs-progressbar": "^0.0.14",
        "node-mailjet": "6.0.11",
        "react": "18.3.1",
        "react-beautiful-dnd": "^13.1.0",
        "react-dom": "18.3.1",
        "react-fade-in": "^2.0.1",
        "recharts": "^2.1.12",
        "styled-components": "^5.3.5",
        "superjson": "^1.8.1",
        "swr": "^1.3.0",
        "typewriter-effect": "^2.18.2",
        "zod": "3.25.76",
        "@prisma/adapter-pg": "7.10.0",
        "nodemailer": "10.0.3"
    },
    "devDependencies": {
        "@playwright/test": "1.58.2",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "13.0.1",
        "@testing-library/user-event": "13.5.0",
        "@types/jest": "29.5.14",
        "@types/node": "22.19.15",
        "@types/react": "18.3.28",
        "@types/react-beautiful-dnd": "^13.1.2",
        "@types/react-dom": "18.3.7",
        "@types/styled-components": "^5.1.25",
        "babel-jest": "29.7.0",
        "babel-plugin-import": "^1.13.5",
        "eslint": "8.57.1",
        "eslint-config-next": "15.5.25",
        "eslint-plugin-testing-library": "5.0.1",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "less": "^4.1.2",
        "prettier": "^2.6.2",
        "prisma": "7.10.0",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": "24.x"
    },
    "packageManager": "yarn@1.22.22"
}
