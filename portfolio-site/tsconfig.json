{
    "compilerOptions": {
        "target": "es2017",
        "lib": ["dom", "esnext"],
        "strict": true,
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "incremental": true,
        "allowJs": true
    },
    "include": [
        "next-env.d.ts",
        "pages/**/*.tsx",
        "../portfolio/**/*.ts",
        "../portfolio/**/*.tsx"
    ],
    "exclude": ["node_modules"]
}
